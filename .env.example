# Copy to .env and fill in. Never commit .env.
# ---- Identity / storage ----
# "laptop" on the Windows worker
CF_HOST_NAME=pi
# CF_DATA_DIR=/home/you/CLipping/data
CF_MEDIA_CAP_GB=5
CF_MIN_FREE_GB=2
CF_RAW_RETENTION_HOURS=48

# ---- Web UI (bind to the Pi's Tailscale IP, never 0.0.0.0) ----
# e.g. 100.x.y.z from `tailscale ip -4`
CF_BIND_HOST=127.0.0.1
CF_PORT=8420
# what Discord links point to
CF_PUBLIC_BASE_URL=http://raspberrypi:8420
# long random string, same on Pi and laptop: openssl rand -hex 24
CF_WORKER_TOKEN=

# ---- Transcription: groq (default) | openai | local | fake ----
CF_TRANSCRIBE_PROVIDER=groq
CF_GROQ_API_KEY=
CF_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---- Clip selection: anthropic (default) | claude_cli | fake ----
CF_SELECT_PROVIDER=anthropic
CF_ANTHROPIC_API_KEY=
CF_SELECT_MODEL=claude-haiku-5-5
CF_CANDIDATES_KEEP=6
# D41: YouTube channel picker: videos listed, and the shortest offered or auto-queued
CF_CHANNEL_LIST_MAX=60
CF_CHANNEL_MIN_VIDEO_S=180

# ---- Render ----
# blurfill | crop
CF_RENDER_LAYOUT=blurfill

# ---- Budget (pauses paid API calls when reached) ----
CF_MONTHLY_BUDGET_USD=15

# ---- Notifications ----
CF_DISCORD_WEBHOOK_URL=
# Posting reminders (local time). One slot per post per platform per day; in week 2 try
# CF_POST_SLOTS=["13:00","18:00"]. The digest lists campaigns ending soon + unsubmitted links.
CF_TIMEZONE=America/Denver
CF_POST_SLOTS=["17:00"]
CF_DIGEST_TIME=09:00

# TikTok inbox drafts (D32): the sandbox app's keys, from developers.tiktok.com
CF_TIKTOK_CLIENT_KEY=
CF_TIKTOK_CLIENT_SECRET=

# ---- Content Rewards and money (D38) ----
# CR's creator terms: 10% of CPM/pool payouts; per-post/retainer 10% under $5,000, 0% above.
CF_CR_FEE=0.10
CF_CR_FEE_FREE_BUDGET_USD=5000
CF_TARGET_HOURLY_USD=50
# Chance a post reaches N views, until the accounts have CF_MIN_POSTS_FOR_ODDS posts of their own
CF_VIEW_ODDS={"500": 0.5, "10000": 0.3, "100000": 0.03, "1000000": 0.003}
CF_MIN_POSTS_FOR_ODDS=30
# Posting pace: 1/day per account for CF_WARMUP_DAYS, then up to this while p90 holds
CF_WARMUP_DAYS=14
CF_POSTS_PER_DAY_MAX=2

